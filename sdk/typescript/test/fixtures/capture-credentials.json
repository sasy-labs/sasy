[
  {
    "name": "exception-url",
    "input": "HTTPStatusError: 403 for url 'https://api.test/v1?key=fixture-secret&n=1'",
    "expected": "HTTPStatusError: 403 for url 'https://api.test/v1?key=[redacted]&n=1'"
  },
  {
    "name": "query-encoding",
    "input": "https://api.test/?%61CCESS_TOKEN=fixture-a&key=fixture-b;key=fixture-c&amp;n=1#frag",
    "expected": "https://api.test/?%61CCESS_TOKEN=[redacted]&key=[redacted];key=[redacted]&amp;n=1#frag"
  },
  {
    "name": "password-dollar",
    "input": "https://user:$realpassword@api.test/a",
    "expected": "https://user:[redacted]@api.test/a"
  },
  {
    "name": "marker-prefix",
    "input": "https://api.test/?key=[redacted]fixture-secret",
    "expected": "https://api.test/?key=[redacted]"
  },
  {
    "name": "signature",
    "input": "https://api.test/?X-Amz-Signature=fixture-secret&X-Goog-Signature=fixture-other",
    "expected": "https://api.test/?X-Amz-Signature=[redacted]&X-Goog-Signature=[redacted]"
  },
  {
    "name": "punctuation-password",
    "input": "https://api.test/?password=fixture.)",
    "expected": "https://api.test/?password=[redacted]"
  },
  {
    "name": "bearer",
    "input": "Authorization: Bearer fixture-secret",
    "expected": "Authorization: [redacted]"
  },
  {
    "name": "digest",
    "input": "Authorization: Digest username=\"fixture-user\", response=\"fixture-secret\", nonce=\"fixture-nonce\"",
    "expected": "Authorization: [redacted]"
  },
  {
    "name": "aws-header",
    "input": "Authorization: AWS4-HMAC-SHA256 Credential=fixture-id, SignedHeaders=host, Signature=fixture-secret",
    "expected": "Authorization: [redacted]"
  },
  {
    "name": "custom-header",
    "input": "Proxy-Authorization: Custom fixture-secret",
    "expected": "Proxy-Authorization: [redacted]"
  },
  {
    "name": "quoted-value",
    "input": "Authorization: \"Bearer fixture-secret\"",
    "expected": "Authorization: [redacted]"
  },
  {
    "name": "curl",
    "input": "curl -H 'Authorization: Bearer fixture-secret' https://api.test/",
    "expected": "curl -H 'Authorization: [redacted]' https://api.test/"
  },
  {
    "name": "header-dollar",
    "input": "X-API-Key: $fixture-secret",
    "expected": "X-API-Key: [redacted]"
  },
  {
    "name": "cookie",
    "input": "Cookie: session=fixture-secret; other=fixture-other\nAccept: application/json",
    "expected": "Cookie: [redacted]\nAccept: application/json"
  },
  {
    "name": "json-header",
    "input": "{\"Authorization\": \"Bearer fixture-secret\", \"ok\": true}",
    "expected": "{\"Authorization\": \"[redacted]\", \"ok\": true}"
  },
  {
    "name": "escaped-header",
    "input": "{\"\\u0061uthorization\":\"Bearer fixture-secret\"}",
    "expected": "{\"\\u0061uthorization\":\"[redacted]\"}"
  },
  {
    "name": "otel-array",
    "input": "{\"http.request.header.authorization\": [\"Bearer fixture-secret\", \"\", \"[redacted]\"]}",
    "expected": "{\"http.request.header.authorization\": [\"[redacted]\",\"\",\"[redacted]\"]}"
  },
  {
    "name": "otel-api",
    "input": "{\"http.response.header.x_api_key\":[\"fixture-secret\"]}",
    "expected": "{\"http.response.header.x_api_key\":[\"[redacted]\"]}"
  },
  {
    "name": "json-url",
    "input": "{\"url\": \"https://api.test/?key=fixture-secret\", \"text\": \"hello\"}",
    "expected": "{\"url\": \"https://api.test/?key=[redacted]\", \"text\": \"hello\"}"
  },
  {
    "name": "nested-json",
    "input": "\"{\\\"url\\\": \\\"https://api.test/?key=fixture-secret\\\"}\"",
    "expected": "\"{\\\"url\\\": \\\"https://api.test/?key=[redacted]\\\"}\""
  },
  {
    "name": "quoted-digest",
    "input": "\"Authorization: Digest username=\\\"fixture-user\\\", response=\\\"fixture-secret\\\"\"",
    "expected": "\"Authorization: [redacted]\""
  },
  {
    "name": "ordinary",
    "input": "key=fixture-ordinary token=fixture-ordinary",
    "expected": "key=fixture-ordinary token=fixture-ordinary"
  },
  {
    "name": "policy",
    "input": "allow(x) :- regex(x, \"sk-[a-z]+\").",
    "expected": "allow(x) :- regex(x, \"sk-[a-z]+\")."
  },
  {
    "name": "url-host",
    "input": "https://authorization:443/path?ordinary=fixture",
    "expected": "https://authorization:443/path?ordinary=fixture"
  },
  {
    "name": "empty-query",
    "input": "https://api.test/?key=&n=1",
    "expected": "https://api.test/?key=&n=1"
  },
  {
    "name": "marker",
    "input": "https://api.test/?key=[redacted]",
    "expected": "https://api.test/?key=[redacted]"
  },
  {
    "name": "json-keys",
    "input": "{\"https://api.test/?key=fixture-key\":\"ordinary\"}",
    "expected": "{\"https://api.test/?key=fixture-key\":\"ordinary\"}"
  },
  {
    "name": "opaque",
    "input": "sk-fixture-opaque-secret",
    "expected": "sk-fixture-opaque-secret"
  },
  {
    "name": "unicode",
    "input": "hello ☃ https://api.test/?n=é",
    "expected": "hello ☃ https://api.test/?n=é"
  },
  {
    "name": "python-header-repr",
    "input": "{'Authorization': 'Bearer fixture-secret', 'ok': True}",
    "expected": "{'Authorization': '[redacted]', 'ok': True}"
  },
  {
    "name": "multiple-curl-headers",
    "input": "curl -H 'Authorization: fixture-one' -H 'X-API-Key: fixture-two'",
    "expected": "curl -H 'Authorization: [redacted]' -H 'X-API-Key: [redacted]'"
  },
  {
    "name": "header-marker-prefix",
    "input": "Authorization: [redacted]fixture-secret",
    "expected": "Authorization: [redacted]"
  },
  {
    "name": "less-than-header",
    "input": "Authorization: <fixture-secret>",
    "expected": "Authorization: [redacted]"
  }
]
